# ==========================================
# OFFICIAL MESSENGER API (RECOMMENDED)
# ==========================================
# For Professional Mode / Facebook Pages
# Get these from https://developers.facebook.com/

PAGE_ACCESS_TOKEN=your-page-access-token-here
VERIFY_TOKEN=your-custom-verify-token-here
PORT=3000

# ==========================================
# BROWSER AUTOMATION (LEGACY)
# ==========================================
# For personal accounts (violates ToS, not recommended)

FB_EMAIL=your-facebook-email@example.com
FB_PASSWORD=your-facebook-password

# ==========================================
# LLM Configuration (Optional)
# ==========================================
# For AI-powered semantic message matching
# Supported providers: claude, openrouter, deepseek
# Leave blank to use simple keyword matching

LLM_PROVIDER=claude
LLM_API_KEY=your-api-key-here

# LLM Provider Options:
# - claude: Get API key from https://console.anthropic.com/
# - openrouter: Get API key from https://openrouter.ai/
# - deepseek: Get API key from https://platform.deepseek.com/
