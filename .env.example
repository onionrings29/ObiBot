# Facebook Login Credentials
# WARNING: Keep your .env file secure and never commit it to git!

FB_EMAIL=your-facebook-email@example.com
FB_PASSWORD=your-facebook-password

# LLM Configuration (Optional - for semantic message matching)
# Supported providers: claude, openrouter, deepseek
# Leave blank to use simple keyword matching

LLM_PROVIDER=claude
LLM_API_KEY=your-api-key-here

# LLM Provider Options:
# - claude: Get API key from https://console.anthropic.com/
# - openrouter: Get API key from https://openrouter.ai/
# - deepseek: Get API key from https://platform.deepseek.com/
